# ===========================================
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

PORT=3000

# JWT Secret — required, must be a strong random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ===========================================
# Database Configuration
# ===========================================
# Option 1: Individual DB variables
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=placement

# Option 2: Single Database URL (takes priority if set)
DATABASE_URL=mysql://user:password@localhost:3306/placement

# For production with external DB
# MYSQL_PUBLIC_URL=mysql://user:password@host:3306/database

# ===========================================
# External Services
# ===========================================
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=JIMS Placement Portal

# ===========================================
# CORS / Frontend
# ===========================================
# Set this to your deployed frontend URL in production
# FRONTEND_URL=https://your-app.vercel.app

# Comma-separated list of additional allowed CORS origins
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://another-domain.com

# ===========================================
# Static File Path (optional, for production)
# ===========================================
# CLIENT_DIST_PATH=../client/dist

# ===========================================
# Node Environment
# ===========================================
# NODE_ENV=production
